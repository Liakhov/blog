---
import { env } from 'cloudflare:workers';
import { SITE } from '@/consts';
import { getDashboardData } from '@/lib/analytics/dashboard-stats';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import StatCard from '@/components/stats/StatsCard.astro';
import StatsSection from '@/components/stats/StatsSection.astro';
import DailyTable from '@/components/stats/StatsDailyTable.astro';
import StatsList from '@/components/stats/StatsList.astro';

const dashboardData = await getDashboardData(env.DB);

const statsData = {
  ...dashboardData,
  maxPages30dViews: dashboardData.topPages30d[0]?.views ?? 1,
  maxPagesAllTimeViews: dashboardData.topPagesAllTime[0]?.views ?? 1,
  maxReferrerHits: dashboardData.topReferrers30d[0]?.hits ?? 1,
  maxBrowserHits: dashboardData.topBrowsers30d[0]?.hits ?? 1,
  maxCountryHits: dashboardData.topCountries30d[0]?.hits ?? 1
};

const liveBreakdowns = [
  {
    title: 'Referrers',
    description:
      'Views by source domain. No referrer includes direct, internal, or hidden sources.',
    items: statsData.liveTodayReferrers.map(r => ({ label: r.referrer, value: r.hits }))
  },
  {
    title: 'Countries',
    description: 'Views by country code. Unknown means the country was unavailable.',
    items: statsData.liveTodayCountries.map(r => ({ label: r.country, value: r.hits }))
  },
  {
    title: 'Browsers',
    description: 'Views by browser. Unknown means the browser was unavailable.',
    items: statsData.liveTodayBrowsers.map(r => ({ label: r.browser, value: r.hits }))
  }
];
---

<BaseLayout title={`Stats | ${SITE.title}`} description="Site analytics" noindex>
  <Header />
  <main class="wrapper mt-4 mb-12">
    <h1 class="text-2xl font-semibold">Stats</h1>
    <p class="mt-1 text-sm text-muted-foreground">
      Privacy-first, server-side tracking — no cookies, no client-side scripts. Rollup-backed
      sections lag by ~2 days; the live section reads raw events.
    </p>

    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      <StatCard
        label="Live (today)"
        views={statsData.liveTodayTotals.views}
        visitors={statsData.liveTodayTotals.visitors}
      />
      <StatCard
        label="Yesterday"
        views={statsData.yesterday.views}
        visitors={statsData.yesterday.visitors}
      />
      <StatCard
        label="7 days"
        views={statsData.total7Days.views}
        visitors={statsData.total7Days.visitors}
      />
      <StatCard
        label="30 days"
        views={statsData.total30Days.views}
        visitors={statsData.total30Days.visitors}
      />
      <StatCard
        label="All time"
        views={statsData.totalAllTime.views}
        visitors={statsData.totalAllTime.visitors}
        class="col-span-2 sm:col-span-3 lg:col-span-1"
      />
    </div>

    <section class="mt-12 border-y border-border py-8" aria-labelledby="live-heading">
      <h2 id="live-heading" class="text-base font-semibold">
        Live <span class="ml-2 text-sm font-normal text-muted-foreground">today · UTC</span>
      </h2>
      <p class="mt-1 text-xs text-muted-foreground">
        Today's traffic, with bots filtered out. Updated when you load this page.
      </p>
      <div class="mt-6 grid items-start gap-6 sm:grid-cols-2">
        <div class="min-w-0 rounded-lg border border-border bg-surface p-5">
          <div class="mb-4 border-b border-border pb-4">
            <h3 class="text-base font-semibold">Pages</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
              Views and unique visitors per page. One visitor can appear on multiple pages.
            </p>
          </div>
          {
            statsData.liveTodayPages.length > 0 ? (
              <table class="mt-3 w-full table-fixed text-sm">
                <thead>
                  <tr class="border-b border-border text-xs text-muted-foreground">
                    <th scope="col" class="pb-2 text-left font-normal">
                      Page
                    </th>
                    <th scope="col" class="w-14 pb-2 text-right font-normal">
                      Views
                    </th>
                    <th scope="col" class="w-16 pb-2 text-right font-normal">
                      Visitors
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {statsData.liveTodayPages.map(row => (
                    <tr class="border-b border-border last:border-0">
                      <th scope="row" class="py-2 pr-3 text-left font-normal">
                        <span class="block truncate" title={row.path}>
                          {row.path}
                        </span>
                      </th>
                      <td class="py-2 text-right tabular-nums">{row.views}</td>
                      <td class="py-2 text-right text-muted-foreground tabular-nums">
                        {row.visitors}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <p class="mt-3 text-sm text-muted-foreground">No traffic yet today</p>
            )
          }
        </div>
        {
          liveBreakdowns.map(breakdown => (
            <div class="min-w-0 rounded-lg border border-border bg-surface p-5">
              <div class="mb-4 border-b border-border pb-4">
                <h3 class="text-base font-semibold">{breakdown.title}</h3>
                <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                  {breakdown.description}
                </p>
              </div>
              {breakdown.items.length > 0 ? (
                <StatsList items={breakdown.items} max={breakdown.items[0]?.value ?? 1} />
              ) : (
                <p class="mt-3 text-sm text-muted-foreground">No traffic yet today</p>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <DailyTable title="Last 7 Days" rows={statsData.last7Days} />
    <DailyTable title="Last 30 Days" rows={statsData.last30Days} scrollable />

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      <StatsSection
        title="Top Pages"
        period="30 days"
        items={statsData.topPages30d.map(r => ({ label: r.path, value: r.views }))}
        max={statsData.maxPages30dViews}
      />
      <StatsSection
        title="Top Pages"
        period="all time"
        items={statsData.topPagesAllTime.map(r => ({ label: r.path, value: r.views }))}
        max={statsData.maxPagesAllTimeViews}
      />
    </div>

    <StatsSection
      title="Referrers"
      period="30 days"
      items={statsData.topReferrers30d.map(r => ({ label: r.referrer, value: r.hits }))}
      max={statsData.maxReferrerHits}
    />

    <div class="mt-10 grid gap-10 sm:grid-cols-2">
      <StatsSection
        title="Browsers"
        period="30 days"
        items={statsData.topBrowsers30d.map(r => ({ label: r.browser, value: r.hits }))}
        max={statsData.maxBrowserHits}
      />
      <StatsSection
        title="Countries"
        period="30 days"
        items={statsData.topCountries30d.map(r => ({ label: r.country, value: r.hits }))}
        max={statsData.maxCountryHits}
      />
    </div>
  </main>
  <Footer />
</BaseLayout>
